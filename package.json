{
  "name": "siteyonetimpaneli_ea",
  "version": "1.0.0",
  "description": "Site yönetim paneli ve sakin portalı yayınlama uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron . --enable-logging",
    "deploy": "gh-pages -d docs",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.siteyonetimpaneli.ea",
    "productName": "Site Yonetim Paneli EA",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "shortcutName": "Site Yönetim Paneli"
    },
    "files": [
      "main.js",
      "veri_koruma.js",
      "github_yayin.js",
      "portal_sifreleme.js",
      "src/**/*",
      "!src/js/*.map"
    ],
    "asar": true
  },
  "keywords": [],
  "author": "erdemalpar",
  "license": "ISC",
  "dependencies": {
    "acorn": "^8.17.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0"
  }
}
